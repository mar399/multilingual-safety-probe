# API keys — set the ones for the providers you plan to use
GROQ_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# Model identifiers — set these to whichever models you want to test
# Aliases are provider-agnostic on purpose; map each to any model string
# your chosen SDK accepts.
MODEL_A=set-your-model-id-here
MODEL_B=set-your-model-id-here
MODEL_C=set-your-model-id-here
MODEL_D=set-your-model-id-here

# Model used by score_results.py to judge responses (recommend a different
# model from the ones under test, to avoid self-scoring bias)
SCORER_MODEL=set-your-model-id-here

# Models used by analyze_reasoning.py
PROBE_MODEL=set-your-model-id-here
ANALYSIS_MODEL=set-your-model-id-here
